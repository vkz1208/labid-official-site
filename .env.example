# Public URL used by canonical metadata and email source links
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Host-only port used by Docker Compose. Production Nginx proxies to this port.
HOST_PORT=3001

# Persistent SQLite path. Mount this directory as a volume in production.
DATABASE_PATH=./data/labid.db

# CMS credentials. No defaults are accepted in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Lead notification recipient
LEAD_NOTIFICATION_EMAIL=276238375@qq.com

# SMTP (leave blank in local development to save leads without sending mail)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local image uploads. In production, persist this directory or replace with object storage.
UPLOAD_DIR=./public/uploads
UPLOAD_PUBLIC_BASE_URL=/api/media
